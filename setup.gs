        ['PRD-06', 6, '20 Games Edukasi Anak', 'Games Edukasi', 'sports_esports', '#F97316', 'https://sites.google.com/view/game-edukasi-2', '20 permainan edukatif interaktif HTML5 ramah ponsel untuk melatih logika berpikir dan kreativitas anak.', '20 Web Game', true],
