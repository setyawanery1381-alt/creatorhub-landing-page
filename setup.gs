      ]
    },
    {
      name: 'Pengguna',
      headers: ['User_ID', 'Username', 'Password', 'Role', 'Status', 'Tanggal_Dibuat'],
      initialData: [
        ['USR-01', 'admin', 'das12345', 'Super Admin', 'Aktif', new Date().toISOString()]
      ]
    }
  ];

  // Eksekusi pembuatan / verifikasi skema secara dinamis
  for (var s = 0; s < schemas.length; s++) {
    var item = schemas[s];
    var sheet = ss.getSheetByName(item.name);
    if (!sheet) {
      sheet = ss.insertSheet(item.name);
    } else {
      sheet.clear();
    }

    // Set header
    sheet.getRange(1, 1, 1, item.headers.length).setValues([item.headers])
      .setFontWeight('bold')
      .setBackground('#01291D')
      .setFontColor('#FFFFFF');

    // Set initial sample data
    if (item.initialData && item.initialData.length > 0) {
      sheet.getRange(2, 1, item.initialData.length, item.headers.length).setValues(item.initialData);
    }

    sheet.autoResizeColumns(1, item.headers.length);

    // Dynamic Execution Log (Wajib)
    Logger.log('Sheet ' + item.name + ' berhasil dibuat / diverifikasi');
  }

  return 'Setup Database Berhasil! Seluruh lembar kerja dan 12 data produk siap digunakan.';
}

