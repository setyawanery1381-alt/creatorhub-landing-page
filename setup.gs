        ['PRD-08', 8, '39000++ Media Anak Kreatif', 'Komunitas & Bahan', 'image', '#0284C7', 'https://drive.google.com/drive/folders/1xsQ7LMcDhzeIsjdnAJ3XbKW8IO72G8ue?usp=drive_link', 'Koleksi raksasa 39.000+ aset grafis, clip art kartun, animasi, audio effect, dan bahan ajar multimedia anak.', '8.2 GB', true],
        ['PRD-09', 9, '1000++ Worksheet Islami', 'Worksheet Anak', 'auto_stories', '#22C55E', 'https://drive.google.com/drive/folders/1B9k8lSlHZXhrmegfGKj8arpWZxiZ4sPN?usp=sharing', '1.000+ lembar mewarnai dan aktivitas edukasi bertema adab, rukun islam, dan kaligrafi ramah anak.', '1.5 GB', true],
