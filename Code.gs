/**
 * Cache Management Engine (Pilar 3)
 */
function getCachedData(key, ttlSeconds) {
  try {
    var cache = CacheService.getScriptCache();
    var cached = cache.get(key);
    if (cached) {
      return JSON.parse(cached);
    }
  } catch (err) {
    Logger.log('Cache read error: ' + err.toString());
  }
  return null;
}

function setCachedData(key, data, ttlSeconds) {
  try {
    var cache = CacheService.getScriptCache();
    var jsonString = JSON.stringify(data);
    // CacheService limit per item is 100KB
    if (jsonString.length < 100000) {
      cache.put(key, jsonString, ttlSeconds || 600);
    }
  } catch (err) {
    Logger.log('Cache write error: ' + err.toString());
  }
}

function invalidateCache(key) {
  try {
    var cache = CacheService.getScriptCache();
    cache.remove(key);
    cache.remove('public_data_payload');
    cache.remove('initial_admin_payload');
  } catch (err) {
    Logger.log('Cache remove error: ' + err.toString());
  }
}

function invalidateMultipleCaches(keys) {
  try {
    var cache = CacheService.getScriptCache();
    cache.removeAll(keys);
    cache.remove('public_data_payload');
    cache.remove('initial_admin_payload');
  } catch (err) {
    Logger.log('Cache removeAll error: ' + err.toString());
  }
}

/**
 * Public Endpoint (MODE A - Hybrid Access):
 * Mengembalikan data publik tanpa kolom sensitif (tanpa password/PIN)
 */
function getPublicData() {
  try {
    var cached = getCachedData('public_data_payload', 600);
    if (cached) {
      return { success: true, data: cached, fromCache: true };
    }

    var ss = SpreadsheetApp.getActiveSpreadsheet();
    if (!ss) {
      return { success: true, data: getFallbackMockData(), isMock: true };
    }

    var sheetKatalog = ss.getSheetByName('Katalog_Produk');
    var sheetConfig = ss.getSheetByName('Pengaturan_Web');

    if (!sheetKatalog || !sheetConfig) {
      return { success: true, data: getFallbackMockData(), isMock: true };
    }

    // 1. Baca Konfigurasi
    var configData = sheetConfig.getDataRange().getValues();
    var config = {
      headerJudul: 'DIGITAL PRODUK',
      headerSub: 'Pelopor Produk Digital No 1',
      headerBadge: '100% BISA DIJUAL KEMBALI',
      waAdmin: '6281331661370',
      pesanWA: 'Halo Admin Sangcreator, saya ingin konfirmasi hak jual dan akses produk digital.'
    };

    for (var i = 1; i < configData.length; i++) {
      var param = String(configData[i][0]).trim();
      var val = configData[i][1];
      if (param === 'Judul_Header' && val) config.headerJudul = String(val);
      if (param === 'Sub_Header' && val) config.headerSub = String(val);
      if (param === 'Badge_Header' && val) config.headerBadge = String(val);
      if (param === 'Nomor_WA_Admin' && val) config.waAdmin = String(val).replace(/[^0-9]/g, '');
      if (param === 'Pesan_WA' && val) config.pesanWA = String(val);
      if (param === 'Hero_Judul' && val) config.heroTitle = String(val);
      if (param === 'Hero_Deskripsi' && val) config.heroDesc = String(val);
      if (param === 'Hero_Badge' && val) config.heroBadge = String(val);
      if (param === 'Hero_Tag1' && val) config.heroTag1 = String(val);
      if (param === 'Hero_Tag2' && val) config.heroTag2 = String(val);
      if (param === 'Hero_Gambar' && val) config.heroImage = String(val);
    }

    // 2. Baca Produk (Batch 2D Array)
    var rawProducts = sheetKatalog.getDataRange().getValues();
    var products = [];
    for (var r = 1; r < rawProducts.length; r++) {
      var row = rawProducts[r];
      var isAktif = row[9] !== false && String(row[9]).toUpperCase() !== 'FALSE';
      if (isAktif && row[2]) {
        products.push({
          id: String(row[0] || 'PRD-' + r),
          order: Number(row[1]) || r,
          title: String(row[2]).trim(),
          category: String(row[3] || 'Umum').trim(),
          icon: String(row[4] || 'inventory_2').trim(),
          color: String(row[5] || '#EF4444').trim(),
          url: String(row[6] || '#').trim(),
          desc: String(row[7] || '').trim(),
          size: String(row[8] || 'Direct').trim(),
          active: true,
          license: '100% Hak Jual',
          imageUrl: String(row[10] || '').trim()
        });
      }
    }

    // Urutkan berdasarkan urutan
    products.sort(function(a, b) {
      return a.order - b.order;
    });

    var resultPayload = {
      config: config,
      products: products
    };

    setCachedData('public_data_payload', resultPayload, 600);
    return { success: true, data: resultPayload, fromCache: false };

  } catch (err) {
    Logger.log('Error getPublicData: ' + err.toString());
    return { success: false, message: err.toString(), fallback: getFallbackMockData() };
  }
}

/**
 * Authentication Engine (Hybrid / Private Guard)
 */
function verifyAdminPin(pin) {
  try {
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    if (!ss) {
      return { success: pin === '12345' };
    }

    var sheetConfig = ss.getSheetByName('Pengaturan_Web');
    if (!sheetConfig) {
      return { success: pin === '12345' };
    }

    var data = sheetConfig.getDataRange().getValues();
    var serverPin = '12345';
    for (var i = 1; i < data.length; i++) {
      if (String(data[i][0]).trim() === 'Admin_PIN' && data[i][1]) {
        serverPin = String(data[i][1]).trim();
        break;
      }
    }

    return { success: String(pin).trim() === serverPin };
  } catch (err) {
    return { success: false, message: err.toString() };
  }
}

/**
 * Save Global Settings (Admin)
 */
function updateSettings(payload, pin) {
  try {
    var auth = verifyAdminPin(pin);
    if (!auth.success) {
      return { success: false, message: 'PIN Admin tidak valid!' };
    }

    var ss = SpreadsheetApp.getActiveSpreadsheet();
    if (!ss) {
      return { success: false, message: 'Spreadsheet tidak aktif.' };
    }

    var sheetConfig = ss.getSheetByName('Pengaturan_Web');
    if (!sheetConfig) {
      return { success: false, message: 'Sheet Pengaturan_Web tidak ditemukan.' };
    }

    var data = sheetConfig.getDataRange().getValues();
    for (var i = 1; i < data.length; i++) {
      var param = String(data[i][0]).trim();
      if (param === 'Judul_Header' && payload.headerJudul !== undefined) data[i][1] = payload.headerJudul;
      if (param === 'Sub_Header' && payload.headerSub !== undefined) data[i][1] = payload.headerSub;
      if (param === 'Badge_Header' && payload.headerBadge !== undefined) data[i][1] = payload.headerBadge;
      if (param === 'Nomor_WA_Admin' && payload.waAdmin !== undefined) data[i][1] = payload.waAdmin;
      if (param === 'Pesan_WA' && payload.pesanWA !== undefined) data[i][1] = payload.pesanWA;
      if (param === 'Admin_PIN' && payload.newPin !== undefined && payload.newPin !== '') data[i][1] = payload.newPin;
      if (param === 'Hero_Judul' && payload.heroTitle !== undefined) data[i][1] = payload.heroTitle;
      if (param === 'Hero_Deskripsi' && payload.heroDesc !== undefined) data[i][1] = payload.heroDesc;
      if (param === 'Hero_Badge' && payload.heroBadge !== undefined) data[i][1] = payload.heroBadge;
      if (param === 'Hero_Tag1' && payload.heroTag1 !== undefined) data[i][1] = payload.heroTag1;
      if (param === 'Hero_Tag2' && payload.heroTag2 !== undefined) data[i][1] = payload.heroTag2;
      if (param === 'Hero_Gambar' && payload.heroImage !== undefined) data[i][1] = payload.heroImage;
    }

    sheetConfig.getRange(1, 1, data.length, 3).setValues(data);
    invalidateCache('public_data_payload');

    return { success: true, message: 'Pengaturan berhasil disimpan!' };
  } catch (err) {
    return { success: false, message: err.toString() };
  }
}

/**
 * CRUD Produk: Tambah / Edit Produk (Admin)
 */
function saveProductItem(product, pin) {
  try {
    var auth = verifyAdminPin(pin);
    if (!auth.success) {
      return { success: false, message: 'PIN Admin tidak valid!' };
    }

    var ss = SpreadsheetApp.getActiveSpreadsheet();
    if (!ss) {
      return { success: false, message: 'Spreadsheet tidak aktif.' };
    }

    var sheet = ss.getSheetByName('Katalog_Produk');
    if (!sheet) {
      return { success: false, message: 'Sheet Katalog_Produk tidak ditemukan.' };
    }

    var rows = sheet.getDataRange().getValues();
    var existingRowIndex = -1;

    for (var r = 1; r < rows.length; r++) {
      if (String(rows[r][0]).trim() === String(product.id).trim()) {
        existingRowIndex = r + 1; // 1-based index
        break;
      }
    }

    var targetOrder = Number(product.order) || (rows.length);
    var targetActive = product.active !== false;

    var rowData = [
      product.id || ('PRD-' + Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyyMMdd-HHmmss')),
      targetOrder,
      product.title || '',
      product.category || 'Umum',
      product.icon || 'inventory_2',
      product.color || '#EF4444',
      product.url || '#',
      product.desc || '',
      product.size || 'Direct',
      targetActive,
      product.imageUrl || ''
    ];

    if (existingRowIndex > 0) {
      sheet.getRange(existingRowIndex, 1, 1, rowData.length).setValues([rowData]);
    } else {
      sheet.appendRow(rowData);
    }

    invalidateCache('public_data_payload');
    return { success: true, message: 'Data produk berhasil disimpan!', item: product };

  } catch (err) {
    return { success: false, message: err.toString() };
  }
}

/**
 * Toggle Status Produk (Aktif / Nonaktif)
 */
function toggleProductStatus(productId, newStatus, pin) {
  try {
    var auth = verifyAdminPin(pin);
    if (!auth.success) {
      return { success: false, message: 'PIN Admin tidak valid!' };
    }

    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = ss.getSheetByName('Katalog_Produk');
    var rows = sheet.getDataRange().getValues();

    for (var r = 1; r < rows.length; r++) {
      if (String(rows[r][0]).trim() === String(productId).trim()) {
        sheet.getRange(r + 1, 10).setValue(Boolean(newStatus));
        invalidateCache('public_data_payload');
        return { success: true, message: 'Status produk diperbarui!' };
      }
    }
    return { success: false, message: 'Produk tidak ditemukan.' };
  } catch (err) {
    return { success: false, message: err.toString() };
  }
}

